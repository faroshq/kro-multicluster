      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "text": "• Platform Team owns RGD definitions\n  on host cluster\n\n• App Teams create instances on\n  their target clusters\n\n• Clear ownership boundaries\n\n• Reduced blast radius per cluster",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
